# crontab entry for automated daily backups (Gate 8 P0).
# Install with: crontab infra/cron/backup.cron
#
# Schedule: 02:00 every day. The script is idempotent — re-runs
# within the same timestamp window are safe but wasteful, so we
# pin to a single 02:00 entry. Add a second entry for staging if
# the schedule needs to differ.
#
# Prereq: create `/etc/universe-erp/backup.env` (mode 0600) containing
# BACKUP_DIR, REDIS_HOST, REDIS_PORT, REDIS_PASSWORD, and optional BACKUP_DEST.
#
# Example log: /var/log/university-erp-backup.log
#
# m h dom mon dow command
0 2 * * *  . /etc/universe-erp/backup.env && /opt/universe-erp/infra/scripts/setup-backups.sh >> /var/log/university-erp-backup.log 2>&1
