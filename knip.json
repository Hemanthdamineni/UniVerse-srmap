{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    "Frontend": {
      "entry": [
        "src/main.tsx",
        "src/styles/index.css",
        "src/pages/**/*.{ts,tsx}",
        "scripts/*.mjs"
      ],
      "project": [
        "src/**/*.{ts,tsx,css}",
        "scripts/**/*.mjs"
      ]
    },
    "Backend": {
      "entry": [
        "server.js",
        "scripts/**/*.js"
      ],
      "project": [
        "src/**/*.js",
        "scripts/**/*.js",
        "load-tests/**/*.js"
      ]
    }
  },
  "tags": ["-lintignore"]
}
