# Staging environment variables (Gate 9 P0).
#
# Staging runs the same images as production but points at a
# separate Redis volume, a separate data volume, and a separate
# ERP dump directory. It MUST NOT share credentials or data with
# production — that is the whole point of having a staging tier.
#
# Copy this file to `.env.staging`, fill in the values for your
# staging host, and source it before `docker compose --env-file
# .env.staging up -d`.
#
# The rule of thumb:
#   1. Different REDIS_PASSWORD (rotation: see infra/runbooks/secret-rotation.md)
#   2. Different data volumes (compose override or new project dir)
#   3. Different ERP dump directory
#   4. Never reuse the production ADMIN_CONTENT_PASSWORD
#   5. Different GRAFANA_ADMIN_PASSWORD
#   6. Different BACKUP_DEST

# --- Redis (staging-internal) ---
REDIS_PASSWORD=replace-me-with-a-staging-only-password
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379

# --- Backend ---
NODE_ENV=production
PORT=5000
SESSION_STORE_DRIVER=auto
ERP_CACHE_DRIVER=auto
SESSION_TTL_MS=1800000
ERP_DUMP_BASE_DIR=/var/lib/university-erp/staging/dump
CONTENT_DB_PATH=/var/lib/university-erp/staging/data/content.sqlite
EXTERNAL_DB_PATH=/var/lib/university-erp/staging/data/external-pages.sqlite
EVENTS_DB_PATH=/var/lib/university-erp/staging/data/events.sqlite
EVENTS_DATA_DIR=/var/lib/university-erp/staging/data/events
ADMIN_CONTENT_PASSWORD=replace-me-with-a-staging-only-password
CAREER_SCRAPER_ENABLED=0
LOG_DIR=/var/log/university-erp-staging

# --- Compose project name (so volumes don't collide with prod) ---
COMPOSE_PROJECT_NAME=university-erp-staging

# --- Monitoring (staging instance) ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-me-with-a-staging-only-password
ALERT_WEBHOOK_URL=http://127.0.0.1:5001/staging-sink
