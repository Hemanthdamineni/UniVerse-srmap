# =============================================================================
# University ERP Companion Platform — Backend Environment Variables
# =============================================================================
# Copy this file to .env and adjust values for your environment.
# All variables have safe defaults; only those marked [REQUIRED] must be set.
# Variables without a default are [OPTIONAL] and fall back to an empty string
# or a computed default — see Backend/src/config/env.js for full details.
# =============================================================================

# -----------------------------------------------------------------------------
# Server Core
# -----------------------------------------------------------------------------
PORT=5000                                    # [OPTIONAL] HTTP server port (default: 5000)
NODE_ENV=development                         # [OPTIONAL] Runtime environment: development | production | test

# -----------------------------------------------------------------------------
# ERP Connection (SRM AP Legacy ERP)
# -----------------------------------------------------------------------------
SRM_BASE_ORIGIN=https://student.srmap.edu.in # [OPTIONAL] ERP base URL origin
SRM_BASE_PATH=/srmapstudentcorner            # [OPTIONAL] ERP base path

# -----------------------------------------------------------------------------
# Admin Access
# -----------------------------------------------------------------------------
ADMIN_CONTENT_PASSWORD=                      # [REQUIRED] Admin password for content/management endpoints
                                            # WARNING: Leaving this empty disables admin endpoints.
ADMIN_REGISTER_NUMBERS=                      # [OPTIONAL] Comma-separated list of admin register numbers
                                            # (e.g. AP23110010419,AP23110010420)

# -----------------------------------------------------------------------------
# Redis (Session Store & Cache Backend)
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379             # [OPTIONAL] Redis connection URL (empty = in-memory fallback)
REDIS_PASSWORD=                              # [OPTIONAL] Redis authentication password
REDIS_SENTINEL_URLS=                         # [OPTIONAL] Comma-separated sentinel endpoints (host1:port1,host2:port2)
REDIS_SENTINEL_MASTER_NAME=mymaster          # [OPTIONAL] Sentinel master name (default: mymaster)

# -----------------------------------------------------------------------------
# Session Management
# -----------------------------------------------------------------------------
SESSION_STORE_DRIVER=auto                    # [OPTIONAL] Session backend: redis | memory | auto
SESSION_TTL_MS=1800000                       # [OPTIONAL] Session TTL in ms (default: 30 min)
SESSION_COOKIE_NAME=erp_session              # [OPTIONAL] Session cookie name
SESSION_COOKIE_SECURE=auto                   # [OPTIONAL] Cookie secure flag: true | false | auto
SESSION_COOKIE_SAME_SITE=lax                 # [OPTIONAL] SameSite: strict | lax | none
LOGIN_PREAUTH_TTL_MS=15000                   # [OPTIONAL] Captcha validity window in ms (default: 15 sec)
LEGACY_SESSION_ID_CUTOFF_DATE=2026-05-15T00:00:00.000Z  # [OPTIONAL] After this date, only cookie sessions accepted

# -----------------------------------------------------------------------------
# ERP Cache
# -----------------------------------------------------------------------------
ERP_CACHE_DRIVER=auto                       # [OPTIONAL] Cache backend: redis | memory | auto
ERP_CACHE_FRESH_TTL_MS=60000                # [OPTIONAL] Data is "fresh" (returned immediately) in ms (default: 1 min)
ERP_CACHE_STALE_TTL_MS=600000               # [OPTIONAL] Data is "stale" (returned with background refresh) in ms (default: 10 min)
ERP_CACHED_TIMEOUT_MS=6000                  # [OPTIONAL] Timeout for cached-first mode live fallback in ms (default: 6 sec)
ERP_LIVE_TIMEOUT_MS=15000                   # [OPTIONAL] Timeout for live-first mode requests in ms (default: 15 sec)

# -----------------------------------------------------------------------------
# ERP Concurrency & Circuit Breaker
# -----------------------------------------------------------------------------
ERP_UPSTREAM_MAX_CONCURRENCY=30             # [OPTIONAL] Max simultaneous ERP requests (default: 30)
ERP_UPSTREAM_ACQUIRE_TIMEOUT_MS=1500        # [OPTIONAL] Max wait for semaphore slot in ms (default: 1500)
ERP_CIRCUIT_FAILURE_THRESHOLD=5             # [OPTIONAL] Failures before circuit opens (default: 5)
ERP_CIRCUIT_COOLDOWN_MS=30000               # [OPTIONAL] Circuit open duration in ms (default: 30 sec)
ERP_CIRCUIT_REDIS_TTL_MS=300000             # [OPTIONAL] Redis TTL for circuit state in ms (default: 5 min)
ERP_DISTRIBUTED_LOCK_TTL_MS=12000           # [OPTIONAL] Distributed lock expiration in ms (default: 12 sec)

# -----------------------------------------------------------------------------
# Feature Flags
# -----------------------------------------------------------------------------
FEATURE_ERP_V2_API=1                        # [OPTIONAL] Enable V2 ERP routes (set 0 to disable)
FEATURE_ERP_CACHED_FIRST=1                  # [OPTIONAL] Enable cache-first strategy (0 = always live-first)
FEATURE_ERP_PREFETCH=1                      # [OPTIONAL] Enable background prefetching
FEATURE_AUTH_COOKIE_MODE=1                  # [OPTIONAL] Enable httpOnly session cookies
FEATURE_ERP_DISTRIBUTED_LOCK=1              # [OPTIONAL] Enable Redis-based distributed locks
FEATURE_ERP_ERROR_ENVELOPE=1                # [OPTIONAL] Return structured error objects
FEATURE_FRONTEND_PERF_TELEMETRY=1           # [OPTIONAL] Accept frontend performance telemetry
FEEDBACK_AUTOMATION_ENABLED=1               # [OPTIONAL] Enable feedback automation (auto-enabled in dev/test)

# -----------------------------------------------------------------------------
# Rate Limiting
# -----------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=60000                  # [OPTIONAL] Sliding window duration in ms (default: 1 min)
RATE_LIMIT_MAX=400                          # [OPTIONAL] Max requests per IP per window (default: 400)
RATE_LIMIT_REDIS_PREFIX=ratelimit           # [OPTIONAL] Redis key prefix for rate limit counters

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
LOG_LEVEL=info                              # [OPTIONAL] Minimum log level: debug | info | warn | error
LOG_DIR=./logs                              # [OPTIONAL] Log file directory
LOG_FILE_NAME=backend.log                   # [OPTIONAL] Log file name
LOGIN_DIAGNOSTICS_DIR=./logs/login-attempts # [OPTIONAL] Login attempt artifact directory
LOGIN_DIAGNOSTICS_MAX_ARTIFACTS=20          # [OPTIONAL] Max stored login diagnostics
LOGIN_DIAGNOSTICS_MAX_HTML_CHARS=6000       # [OPTIONAL] Max HTML chars per diagnostic

# -----------------------------------------------------------------------------
# Database Paths (SQLite)
# -----------------------------------------------------------------------------
EXTERNAL_DB_PATH=./data/external-pages.sqlite       # [OPTIONAL] External pages SQLite database path
CONTENT_DB_PATH=./data/content.sqlite               # [OPTIONAL] Content SQLite database path
EVENTS_DB_PATH=./data/events.sqlite                 # [OPTIONAL] Events SQLite database path
HELPDESK_DB_PATH=./data/helpdesk.sqlite             # [OPTIONAL] Helpdesk SQLite database path
CAMPUS_FEEDBACK_DB_PATH=./data/campus-feedback.sqlite # [OPTIONAL] Campus feedback SQLite database path
CAREER_DB_PATH=./data/career.sqlite                 # [OPTIONAL] Career portal SQLite database path
LMS_DB_PATH=./data/lms.sqlite                       # [OPTIONAL] LMS SQLite database path
LMS_TRACKER_DB_PATH=./data/lms-tracker.sqlite       # [OPTIONAL] LMS tracker SQLite database path
UNIFIED_PROFILE_DB_PATH=./data/unified-profile.sqlite # [OPTIONAL] Unified profile SQLite database path
COMPANION_ANALYTICS_DB_PATH=./data/companion-analytics.sqlite # [OPTIONAL] Companion analytics SQLite database path

# -----------------------------------------------------------------------------
# Data Directory Paths
# -----------------------------------------------------------------------------
EVENTS_DATA_DIR=./data/events                       # [OPTIONAL] Events filesystem storage directory
UPLOADS_DIR=./data/uploads                          # [OPTIONAL] File upload directory
LMS_FILES_DIR=./data/lms                            # [OPTIONAL] LMS files storage directory

# -----------------------------------------------------------------------------
# LMS Configuration
# -----------------------------------------------------------------------------
LMS_UPLOAD_MAX_BYTES=26214400                       # [OPTIONAL] Max bytes per LMS upload (default: 25 MB)
LMS_USER_STORAGE_MAX_BYTES=209715200                # [OPTIONAL] Max storage per user in bytes (default: 200 MB)
LMS_UPLOADS_PER_DAY_MAX=10                          # [OPTIONAL] Max uploads per user per day
LMS_QUEUE_FLUSH_MS=300                              # [OPTIONAL] LMS interaction queue flush interval in ms
LMS_QUEUE_BATCH_SIZE=50                             # [OPTIONAL] LMS interaction queue batch size
LMS_QUEUE_MAX_RETRIES=3                             # [OPTIONAL] LMS interaction queue max retries

# -----------------------------------------------------------------------------
# Career Portal
# -----------------------------------------------------------------------------
CAREER_CACHE_TTL_SEC=90                             # [OPTIONAL] Career data cache TTL in seconds
CAREER_SUBMISSION_REVIEW_ROLES=                     # [OPTIONAL] Comma-separated roles for review (overrides built-in)
CAREER_LOAD_TEST_TOKEN=                             # [OPTIONAL] Auth token for career k6 load tests

# -----------------------------------------------------------------------------
# ERP Artifacts & File Paths
# -----------------------------------------------------------------------------
ERP_PAGE_POLICY_FILE=./src/config/erp-page-policy.json  # [OPTIONAL] Page policy config file path
ERP_UI_MAP_FILE=                                        # [OPTIONAL] ERP UI mapping file (optional feature)
ERP_ARTIFACT_MAX_AGE_DAYS=14                            # [OPTIONAL] Max age for ERP dump artifacts in days
FRONTEND_BLUEPRINT_FILE=../Frontend/src/config/erpBlueprints.ts  # [OPTIONAL] Frontend blueprint file path

# -----------------------------------------------------------------------------
# Static Prototype Mode (used when building frontend for static deployment)
# -----------------------------------------------------------------------------
VITE_STATIC_PROTOTYPE=false                       # [OPTIONAL] Set to true for static prototype build mode
