{
  "name": "university-erp-v2-backend",
  "version": "2.0.0",
  "description": "Clean backend API for University ERP frontend",
  "main": "server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node src/server.js",
    "test": "node --test",
    "discover:endpoints": "node scripts/endpoint-discovery.js data/endpoint-discovery.json",
    "fetch:endpoints": "node scripts/fetch-discovered-endpoints.js data/endpoint-discovery.json data/direct-api-output",
    "preprocess:endpoints": "node scripts/preprocess-fetched-endpoints.js data/direct-api-output/fetched-endpoints.json data/direct-api-output/fetched-endpoints.typed.json",
    "import:learning-materials": "node scripts/import-learning-materials.js",
    "analyze:ui-map": "node scripts/analyze-erp-ui-map.js",
    "verify:integrity": "node scripts/check-erp-integrity.js",
    "refresh:artifacts:manual": "node scripts/manual-refresh-artifacts.js --run",
    "map:template": "node scripts/generate-content-map-template.js data/endpoint-discovery.json data/erp-content-map.template.json",
    "seed:external": "node scripts/seed-external-pages.js",
    "load:cached": "k6 run load-tests/erp-cached.js",
    "load:live": "k6 run load-tests/erp-live.js",
    "load:mixed": "k6 run load-tests/erp-mixed.js",
    "load:career": "k6 run load-tests/career-portal.js",
    "seed:career:stress": "node scripts/seed-career-stress-sqlite.mjs --out data/career-stress.sqlite --count 150000 --force"
  },
  "dependencies": {
    "cheerio": "^1.1.2",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "multer": "^2.1.1",
    "playwright": "^1.55.0",
    "prom-client": "^15.1.3",
    "redis": "^5.8.2"
  }
}
