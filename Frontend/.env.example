# =============================================================================
# University ERP Companion Platform — Frontend Environment Variables
# =============================================================================
# Copy this file to .env and adjust values for your environment.
# All Vite-exposed variables must be prefixed with VITE_.
# =============================================================================

# -----------------------------------------------------------------------------
# API Configuration
# -----------------------------------------------------------------------------
VITE_API_BASE_URL=                    # [OPTIONAL] Backend API base URL (e.g. http://localhost:5000/api)
                                      # When empty, relative /api/* URLs are used (proxied by Vite dev server).

VITE_API_PROXY_TARGET=http://localhost:5000  # [OPTIONAL] Vite dev proxy target for /api and /uploads routes.
                                             # Only used in dev mode (ignored in production builds).

# -----------------------------------------------------------------------------
# Feature Flags
# -----------------------------------------------------------------------------
VITE_STATIC_PROTOTYPE=false           # [OPTIONAL] Set to true for static prototype mode.
                                      # When true: assets use relative paths (base: "./"),
                                      # output goes to ../StaticHost/dist.
                                      # API modules return fixture data.

VITE_DEBUG_MODE=false                 # [OPTIONAL] Set to true to enable debug-level logging and
                                      # development-only UI panels in the frontend.

# -----------------------------------------------------------------------------
# Admin Access
# -----------------------------------------------------------------------------
VITE_ADMIN_REGISTER_NUMBERS=          # [OPTIONAL] Comma-separated list of admin register numbers
                                      # for frontend admin UI features
                                      # (e.g. AP23110010419,AP23110010420)
