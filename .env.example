# ── Required ────────────────────────────────────────────────
REDIS_PASSWORD=change-this-to-a-strong-random-password

# ── Grafana (only needed with monitoring stack) ─────────────
GRAFANA_ADMIN_PASSWORD=change-this-too
GRAFANA_ADMIN_USER=admin

# ── Optional overrides ──────────────────────────────────────
# VITE_API_PROXY_TARGET=http://localhost:5000
# NODE_ENV=production

# ── Career scraper (runs for the backend's lifetime) ────────
# The backend spawns Scraper/main.py on startup and restarts it if it crashes.
# Set to 0 to disable automatic scraping entirely.
# CAREER_SCRAPER_ENABLED=1
# Hours between full scrape runs (default 6).
# SCRAPER_RUN_INTERVAL_HOURS=6
# Restart backoff after a scraper crash, in ms (doubles up to the max).
# CAREER_SCRAPER_RESTART_DELAY_MS=30000
# CAREER_SCRAPER_RESTART_DELAY_MAX_MS=900000
# Per-source kill switches (jobspy | devfolio | unstop | internshala | devpost | ats | remoteok | remotive).
# SCRAPER_ENABLE_JOBSPY=1
# SCRAPER_ENABLE_DEVFOLIO=1
# SCRAPER_ENABLE_UNSTOP=1
# SCRAPER_ENABLE_INTERNSHALA=1
# SCRAPER_ENABLE_DEVPOST=1
# SCRAPER_ENABLE_ATS=1
# SCRAPER_ENABLE_REMOTEOK=1
# SCRAPER_ENABLE_REMOTIVE=1
# Optional proxy pool for scraping traffic, comma-separated:
# SCRAPER_PROXIES=http://user:pass@host:port,socks5://host:port
# Depth knobs (defaults shown): jobspy window/results, Unstop pagination,
# Devpost pages, ATS student-role filter.
# SCRAPER_HOURS_OLD=72
# SCRAPER_RESULTS_WANTED=100
# SCRAPER_UNSTOP_MAX_PAGES=8
# SCRAPER_DEVPOST_MAX_PAGES=5
# Set to 0 to keep only intern/trainee/graduate roles on ATS boards.
# SCRAPER_ATS_INCLUDE_ALL_ROLES=1
